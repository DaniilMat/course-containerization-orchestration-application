# Этап 1. Builder — установка зависимостей
FROM python:3.11-slim AS builder

WORKDIR /app

# Копирование списка зависимостей
COPY requirements.txt .

# --no-cache-dir: pip не хранит кэш скачанных пакетов в образе
# --prefix: ставит в отдельный каталог, чтобы целиком перенести его в runtime
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt


# Этап 2. Runtime — финальный образ
FROM python:3.11-slim AS runtime

# Метаданные
LABEL maintainer="matveev@lab.local"
LABEL version="2.0"

# Рабочая директория
WORKDIR /app

# Порт приложения
ENV PORT=5489

# Перенос только готовых пакетов, без pip-кэша и инструментов сборки
COPY --from=builder /install /usr/local

# Добавление установленных библиотек в PATH
ENV PATH="/opt/venv/bin:$PATH"

# Копирование исходного кода приложения
COPY app ./app

# Открытие порта
EXPOSE ${PORT}

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
CMD curl -f http://localhost:${PORT}/health || exit 1

# Запуск FastAPI
CMD uvicorn app.main:app --host 0.0.0.0 --port ${PORT}
